{
  "name": "fleet-ops",
  "version": "2.0.0",
  "private": true,
  "description": "Automation for a fleet of GitHub repositories: scheduler, governance, GitLab mirror and backup",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "workspaces": [
    "packages/*",
    "workers/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/node": "^22.20.7",
    "@vitest/coverage-v8": "^5.1.2",
    "fast-check": "^4.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "register-commands": "tsx packages/chatops/scripts/register.ts"
  }
}
