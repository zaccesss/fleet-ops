# every value below is a placeholder. Real values live in Cloudflare Worker secrets or GitHub
# Actions secrets, never in a file in this repository.

# the GitHub App that every service acts as
GITHUB_APP_ID=replace-me
GITHUB_APP_PRIVATE_KEY=replace-me-with-the-app-key-in-pkcs8-pem-form
GITHUB_WEBHOOK_SECRET=replace-me

# slash commands in Discord
DISCORD_APPLICATION_ID=replace-me
DISCORD_PUBLIC_KEY=replace-me
DISCORD_BOT_TOKEN=replace-me
# comma separated Discord user IDs allowed to run commands
CHATOPS_OWNER_IDS=replace-me,replace-me-too

# where job results are posted (any endpoint that accepts a JSON POST)
NOTIFY_WEBHOOK_URL=https://example.invalid/notify

# the GitLab side of the mirror
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=replace-me

# the read token the mirror and backup use on GitHub
GITHUB_TOKEN=replace-me
